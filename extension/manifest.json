{
  "manifest_version": 3,
  "name": "Cue bubble",
  "version": "1.0.0",
  "description": "A movable Cue bubble on every page. Tap it to open Cue in its own small window.",
  "icons": { "16": "icons/cue-16.png", "48": "icons/cue-48.png", "128": "icons/cue-128.png" },
  "action": { "default_title": "Open Cue", "default_icon": { "16": "icons/cue-16.png", "48": "icons/cue-48.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "options_page": "options.html",
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }]
}
