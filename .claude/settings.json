{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|mcp__github__actions_run_trigger",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "kiko-claude-addons": {
      "source": {
        "source": "github",
        "repo": "kikodacanay14/Canvas"
      }
    }
  },
  "enabledPlugins": {
    "kiko-questions@kiko-claude-addons": true
  }
}
